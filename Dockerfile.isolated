# Chạy lab trong container, shell của tác tử bị cô lập khỏi kho mã nguồn.
# Kho được mount vào /secure/lab; /secure chỉ root vào được. Runner chạy bằng root (đọc được tasks/, .env),
# còn lệnh shell của tác tử chạy bằng user `agent` (xem IsolatedShellBackend trong src/lab/agent.py).
#
# Build:  docker build -f Dockerfile.isolated -t lab-isolated .
# Run:    docker run --rm -it -v "${PWD}:/secure/lab" lab-isolated
FROM python:3.12-slim
RUN apt-get update && apt-get install -y --no-install-recommends git && rm -rf /var/lib/apt/lists/* \
    && useradd --create-home agent && mkdir -m 700 /secure
WORKDIR /secure/lab
COPY pyproject.toml ./
COPY src ./src
RUN pip install --no-cache-dir -e .
ENV LAB_AGENT_USER=agent
CMD ["bash"]
